;
; This code is automatically generated by the FormDesigner.
; Manual modification is possible to adjust existing commands, but anything else will be dropped when the code is compiled.
; Event procedures needs to be put in another source file.
;

Enumeration FormWindow
  #MainWindow
EndEnumeration

Enumeration FormMenu
  #MENU_NEW
  #MENU_EXIT
EndEnumeration

Declare ExitGame(Event)
Declare NewGame(Event)

Procedure OpenMainWindow(x = 0, y = 0, width = 533, height = 400)
  OpenWindow(#MainWindow, x, y, width, height, "Pacman", #PB_Window_SystemMenu | #PB_Window_TitleBar | #PB_Window_ScreenCentered)
  SetWindowColor(#MainWindow, RGB(192,192,192))
  CreateStatusBar(0, WindowID(#MainWindow))
  AddStatusBarField(50)
  StatusBarText(0, 0, "Score :")
  CreateMenu(0, WindowID(#MainWindow))
  MenuTitle("File")
  MenuItem(#MENU_NEW, "New")
  MenuItem(#MENU_EXIT, "Exit")
EndProcedure

Procedure MainWindow_Events(event)
  Select event
    Case #PB_Event_CloseWindow
      ProcedureReturn #False

    Case #PB_Event_Menu
      Select EventMenu()
        Case #MENU_NEW
          NewGame(EventMenu())
        Case #MENU_EXIT
          ExitGame(EventMenu())
      EndSelect

    Case #PB_Event_Gadget
      Select EventGadget()
      EndSelect
  EndSelect
  ProcedureReturn #True
EndProcedure


